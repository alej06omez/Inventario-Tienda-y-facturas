<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.tienda.inventario.controller.CategoriaController" styleClass="formulario">
    <columnConstraints><ColumnConstraints minWidth="-Infinity"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
    <Label text="Nombre *" GridPane.rowIndex="0"/>          <TextField fx:id="nombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Tipo *" GridPane.rowIndex="1"/>            <TextField fx:id="tipo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Label text="Umbral de stock *" GridPane.rowIndex="2"/> <TextField fx:id="umbral" text="10" styleClass="campo-corto" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Label text="* Campo obligatorio" styleClass="nota" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    <Label fx:id="mensaje" styleClass="mensaje-error" wrapText="true" maxWidth="320" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    <Button text="Guardar" defaultButton="true" styleClass="primario" onAction="#guardar" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
</GridPane>
