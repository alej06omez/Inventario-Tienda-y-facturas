<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.tienda.inventario.controller.VentaController" spacing="8" styleClass="formulario">
    <GridPane hgap="10" vgap="8">
        <columnConstraints><ColumnConstraints minWidth="-Infinity"/><ColumnConstraints/><ColumnConstraints minWidth="-Infinity"/><ColumnConstraints/><ColumnConstraints/></columnConstraints>
        <Label text="Cajero *" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cajero" promptText="Seleccione cajero..." GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button text="Nuevo cajero..." onAction="#nuevoCajero" GridPane.rowIndex="0" GridPane.columnIndex="2" GridPane.columnSpan="2"/>
        <Label text="Producto *" GridPane.rowIndex="1"/>
        <ComboBox fx:id="producto" promptText="Seleccione producto..." GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Cantidad *" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="cantidad" styleClass="campo-corto" onAction="#agregarLinea" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
        <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="4">
            <Button text="Agregar línea" onAction="#agregarLinea"/>
            <Button text="Quitar línea" onAction="#quitarLinea"/>
        </HBox>
    </GridPane>
    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        <placeholder><Label text="Agregue productos a la venta"/></placeholder>
        <columns>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="260"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="90" styleClass="numero"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="110"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="120"/>
        </columns>
    </TableView>
    <Label fx:id="mensaje" styleClass="mensaje-error" wrapText="true"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="total" text="Total (referencia): 0" styleClass="total"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Registrar venta" styleClass="primario" onAction="#registrarVenta"/>
    </HBox>
</VBox>
